<BorderPane
        prefWidth="1000.0"
        prefHeight="780.0"
        style="-fx-background-color: #FBFBFB; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;"
        xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.auction.client.controller.LoginController">

    <top>
        <HBox alignment="CENTER_LEFT" minWidth="-Infinity" style="-fx-padding: 20 50 20 50;">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111;" text="AuctionApp" />
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="60">
            <padding>
                <Insets bottom="60" left="50" right="50" top="40" />
            </padding>

            <VBox maxWidth="500" spacing="25" HBox.hgrow="ALWAYS">
                <HBox />

                <TextFlow lineSpacing="-10">
                    <Text style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-fill: #111;" text="The Perfect&#10;" />
                    <Text style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-fill: #111;" text="Place for&#10;" />
                    <Text style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-fill: #5B6C7E;" text="Your Bidding." />
                </TextFlow>
            </VBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        prefWidth="460"
                        style="-fx-background: transparent; -fx-background-color: transparent;
                       -fx-border-color: transparent; -fx-padding: 0;">
                <VBox alignment="CENTER" spacing="25">

                    <VBox prefWidth="420" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 20, 0, 0, 10);">

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111;" text="Sign in to your account" />
                        </VBox>

                        <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Username">
                                <font>
                                    <Font size="14.0" />
                                </font></Label>
                            <TextField fx:id="usernameField" promptText="Username" style="-fx-background-color: #EFEFEF; -fx-padding: 14; -fx-background-radius: 6; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <HBox alignment="CENTER_LEFT">
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Password">
                                    <font>
                                        <Font size="14.0" />
                                    </font></Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5A6D88; -fx-cursor: hand;" text="Forget Password?" />
                            </HBox>
                            <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-background-color: #EFEFEF; -fx-padding: 14; -fx-background-radius: 6; -fx-font-size: 14px;" />
                        </VBox>

                        <Button fx:id="loginButton" maxWidth="Infinity" onAction="#onLogin" prefHeight="47.0" prefWidth="339.0" style="-fx-background-color: black; -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Login" textAlignment="CENTER" VBox.vgrow="ALWAYS" />
                        <Label fx:id="statusLabel" prefHeight="17.0" prefWidth="353.0" textFill="#eb0505" />

                        <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                            <TextFlow textAlignment="CENTER">
                                <Text style="-fx-font-size: 12px; -fx-fill: #666;" text="New to Auction App? " />
                                <Text fx:id="registerButton"
                                      style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-fill: #111; -fx-cursor: hand;"
                                      text="Register"
                                      onMouseClicked="#onGoRegister" />
                            </TextFlow>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 25 50 25 50; -fx-background-color: #EFEFEF;">
            <Label fx:id="copyrightNotice" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #333;" text="© 2026 PRODUCT OF HQLP" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="30">
                <Label fx:id="privacyLabel" style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: bold; -fx-cursor: hand;" text="PRIVACY" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: bold; -fx-cursor: hand;" text="TERMS" />
            </HBox>
        </HBox>
    </bottom>

</BorderPane>