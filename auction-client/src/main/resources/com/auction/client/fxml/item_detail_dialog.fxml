<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:controller="com.auction.client.controller.ItemDetailDialogController"
            prefWidth="620" prefHeight="500"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ═══ HEADER ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: #1a1a2e; -fx-padding: 14 20 14 20;">
            <Label fx:id="titleLabel"
                   style="-fx-text-fill: white; -fx-font-size: 15px;
                          -fx-font-weight: bold; -fx-font-family: 'Georgia', serif;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="categoryBadge"
                   style="-fx-background-color: #ffffff22; -fx-text-fill: #ccc;
                          -fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-background-radius: 4; -fx-padding: 3 8 3 8;" />
        </HBox>
    </top>

    <!-- ═══ BODY ═══ -->
    <center>
        <HBox spacing="0">

            <!-- ── Left: image + description ── -->
            <VBox spacing="14" prefWidth="210" minWidth="210"
                  style="-fx-padding: 20 16 20 20;
                         -fx-border-color: transparent #EAEAEA transparent transparent;
                         -fx-border-width: 1;">

                <!-- Image box -->
                <StackPane prefHeight="160" prefWidth="174"
                           style="-fx-background-color: #f5f5f5;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <ImageView fx:id="itemImage"
                               fitWidth="170" fitHeight="156"
                               preserveRatio="true"
                               smooth="true" />
                    <Label fx:id="noImageLabel" text="No image"
                           style="-fx-text-fill: #aaa; -fx-font-size: 11px;" />
                </StackPane>

                <!-- Description -->
                <Label text="DESCRIPTION"
                       style="-fx-font-size: 9px; -fx-font-weight: bold;
                              -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                <Label fx:id="descLabel" wrapText="true"
                       style="-fx-font-size: 11px; -fx-text-fill: #444;
                              -fx-line-spacing: 2;" />

                <!-- Extra info (JSON / notes) -->
                <Label fx:id="extraSection" text="EXTRA INFO"
                       style="-fx-font-size: 9px; -fx-font-weight: bold;
                              -fx-text-fill: #999; -fx-letter-spacing: 1;" />
                <Label fx:id="extraLabel" wrapText="true"
                       style="-fx-font-size: 10px; -fx-text-fill: #666;
                              -fx-font-family: monospace;" />
            </VBox>

            <!-- ── Right: stats + auction table ── -->
            <VBox spacing="14" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 20 20 20 16;">

                <!-- Quick-stat chips -->
                <HBox spacing="10">
                    <VBox styleClass="stat-chip"
                          style="-fx-background-color: #f8f8f8;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 8;
                                 -fx-border-width: 1; -fx-padding: 10 16 10 16;
                                 -fx-alignment: CENTER;">
                        <Label fx:id="totalAuctionsLabel"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                        <Label text="AUCTIONS"
                               style="-fx-font-size: 9px; -fx-text-fill: #888; -fx-font-weight: bold;" />
                    </VBox>
                    <VBox style="-fx-background-color: #f8f8f8;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 8;
                                 -fx-border-width: 1; -fx-padding: 10 16 10 16;
                                 -fx-alignment: CENTER;">
                        <Label fx:id="highestBidLabel"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" />
                        <Label text="HIGHEST BID"
                               style="-fx-font-size: 9px; -fx-text-fill: #888; -fx-font-weight: bold;" />
                    </VBox>
                    <VBox style="-fx-background-color: #f8f8f8;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 8;
                                 -fx-border-width: 1; -fx-padding: 10 16 10 16;
                                 -fx-alignment: CENTER;">
                        <Label fx:id="activeAuctionLabel"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #c62828;" />
                        <Label text="LIVE NOW"
                               style="-fx-font-size: 9px; -fx-text-fill: #888; -fx-font-weight: bold;" />
                    </VBox>
                </HBox>

                <!-- Auctions table -->
                <Label text="AUCTION HISTORY"
                       style="-fx-font-size: 9px; -fx-font-weight: bold;
                              -fx-text-fill: #999; -fx-letter-spacing: 1;" />

                <TableView fx:id="auctionHistoryTable" VBox.vgrow="ALWAYS"
                           style="-fx-font-size: 11px;">
                    <columns>
                        <TableColumn fx:id="colAucId"     text="#"       prefWidth="38" />
                        <TableColumn fx:id="colAucStatus" text="STATUS"  prefWidth="90" />
                        <TableColumn fx:id="colAucPrice"  text="PRICE"   prefWidth="80" />
                        <TableColumn fx:id="colAucEnds"   text="ENDS"    prefWidth="120" />
                    </columns>
                    <placeholder>
                        <Label text="No auctions for this item."
                               style="-fx-text-fill: #aaa; -fx-font-size: 11px;" />
                    </placeholder>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <!-- ═══ FOOTER ═══ -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding: 10 20 14 20;
                     -fx-border-color: #EAEAEA transparent transparent transparent;
                     -fx-border-width: 1;">
            <Button text="CLOSE" onAction="#onClose"
                    style="-fx-background-color: #1a1a2e; -fx-text-fill: white;
                           -fx-font-size: 10px; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-background-radius: 4;
                           -fx-padding: 7 22 7 22;" />
        </HBox>
    </bottom>

</BorderPane>
