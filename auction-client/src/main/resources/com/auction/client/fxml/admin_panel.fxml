<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.auction.client.controller.AdminController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="680"
            minWidth="900"  minHeight="620"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

<!-- ═══════════════════ HEADER ═══════════════════ -->
<top>
    <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
          style="-fx-padding: 10 20 10 20;">
        <Label styleClass="logo-title" text="AuctionApp"
               style="-fx-font-size: 15px;" />

        <HBox alignment="CENTER" spacing="20">
            <Label styleClass="nav-link-active" text="ADMIN PANEL" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="userLabel"
               style="-fx-font-size: 11px; -fx-text-fill: #888;
                          -fx-font-family: 'Georgia', serif;
                          -fx-font-style: italic;" />

        <HBox alignment="CENTER" spacing="12">
            <Button text="VIEW AUCTIONS" onAction="#onViewAuctions"
                    styleClass="btn-secondary"
                    style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            <Button text="LOG OUT" onAction="#onLogout"
                    styleClass="btn-danger"
                    style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
        </HBox>
    </HBox>
</top>

<!-- ═══════════════════ SIDEBAR ═══════════════════ -->
<left>
    <VBox prefWidth="160" spacing="3" styleClass="sidebar"
          style="-fx-border-color: transparent #EAEAEA transparent transparent;
                     -fx-border-width: 1; -fx-padding: 20 0 0 0;">
        <Label styleClass="sidebar-title" text="MANAGEMENT"
               style="-fx-padding: 0 0 0 18;" />
        <Label styleClass="sidebar-subtitle" text="ADMIN CONTROLS"
               style="-fx-padding: 0 0 10 18;" />

        <HBox alignment="CENTER_LEFT" spacing="8"
              styleClass="category-item-active"
              style="-fx-padding: 9 18 9 18;">
            <Label styleClass="category-text" text="👤" />
            <Label styleClass="category-text" text="USERS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8"
              styleClass="category-item"
              style="-fx-padding: 9 18 9 18; -fx-cursor: hand;"
              onMouseClicked="#onViewAuctions">
            <Label styleClass="category-text" text="🔨" />
            <Label styleClass="category-text" text="AUCTIONS" />
        </HBox>
    </VBox>
</left>

<!-- ═══════════════════ CONTENT ═══════════════════ -->
<center>
    <VBox spacing="18" style="-fx-padding: 22 28 22 22;">

        <!-- Section header -->
        <HBox alignment="BOTTOM_LEFT">
            <VBox spacing="5">
                <Label styleClass="section-title" text="User Management"
                       style="-fx-font-size: 20px;" />
                <Label styleClass="section-desc"
                       text="View, monitor, and moderate all registered accounts."
                       style="-fx-font-size: 11px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="↻  REFRESH" onAction="#onRefresh"
                    styleClass="btn-secondary"
                    style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
        </HBox>

        <!-- User table -->
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colId"       text="ID"       prefWidth="55" />
                <TableColumn fx:id="colUsername"  text="USERNAME" prefWidth="180" />
                <TableColumn fx:id="colEmail"     text="EMAIL"    prefWidth="240" />
                <TableColumn fx:id="colRole"      text="ROLE"     prefWidth="110" />
                <TableColumn fx:id="colActive"    text="STATUS"   prefWidth="100" />
            </columns>
            <placeholder>
                <Label text="No users found." styleClass="table-placeholder" />
            </placeholder>
        </TableView>

        <!-- Action bar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="⛔  BAN SELECTED" onAction="#onBanUser"
                    styleClass="btn-danger"
                    style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            <Button text="✅  UNBAN SELECTED" onAction="#onUnbanUser"
                    styleClass="btn-secondary"
                    style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            <Label fx:id="statusLabel" styleClass="bid-status"
                   style="-fx-font-size: 11px;" />
        </HBox>

    </VBox>
</center>

</BorderPane>
