<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:controller="com.auction.client.controller.AdminController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="680"
            minWidth="900"  minHeight="620"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
              style="-fx-padding: 10 20 10 20;">
            <Label styleClass="logo-title" text="AuctionApp"
                   style="-fx-font-size: 15px;" />

            <HBox alignment="CENTER" spacing="20">
                <Label styleClass="nav-link-active" text="ADMIN PANEL" />
            </HBox>

            <HBox alignment="CENTER" spacing="20">
                <Label fx:id="navAll"     styleClass="nav-link-active" text="ALL USERS"
                       style="-fx-cursor: hand;" onMouseClicked="#onNavAll" />
                <Label fx:id="navAdmins"  styleClass="nav-link"        text="ADMINS"
                       style="-fx-cursor: hand;" onMouseClicked="#onNavAdmins" />
                <Label fx:id="navSellers" styleClass="nav-link"        text="SELLERS"
                       style="-fx-cursor: hand;" onMouseClicked="#onNavSellers" />
                <Label fx:id="navBidders" styleClass="nav-link"        text="BIDDERS"
                       style="-fx-cursor: hand;" onMouseClicked="#onNavBidders" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="userLabel"
                   style="-fx-font-size: 11px; -fx-text-fill: #888;
                          -fx-font-family: 'Georgia', serif;
                          -fx-font-style: italic;" />

            <HBox alignment="CENTER" spacing="12">
                <Button text="VIEW AUCTIONS" onAction="#onViewAuctions"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
                <Button text="LOG OUT" onAction="#onLogout"
                        styleClass="btn-danger"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <left>
        <AnchorPane prefWidth="160" minWidth="160"
                    style="-fx-border-color: transparent #EAEAEA transparent transparent;
                       -fx-border-width: 1;
                       -fx-background-color: -fx-sidebar-bg, transparent;">

            <!-- Top nav items -->
            <VBox spacing="3" styleClass="sidebar"
                  style="-fx-padding: 20 0 0 0; -fx-background-color: transparent;"
                  AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                <Label styleClass="sidebar-title" text="MANAGEMENT"
                       style="-fx-padding: 0 0 0 18;" />
                <Label styleClass="sidebar-subtitle" text="ADMIN CONTROLS"
                       style="-fx-padding: 0 0 10 18;" />

                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item-active"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="👤" />
                    <Label styleClass="category-text" text="USERS" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18; -fx-cursor: hand;"
                      onMouseClicked="#onViewAuctions">
                    <Label styleClass="category-text" text="🔨" />
                    <Label styleClass="category-text" text="AUCTIONS" />
                </HBox>
            </VBox>

            <!-- Profile — anchored to bottom -->
            <VBox spacing="0"
                  AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18; -fx-cursor: hand;"
                      onMouseClicked="#onViewProfile">
                    <Label styleClass="category-text" text="👤" />
                    <Label styleClass="category-text" text="MY PROFILE" />
                </HBox>
            </VBox>

        </AnchorPane>
    </left>

    <!-- ═══════════════════ CONTENT ═══════════════════ -->
    <center>
        <VBox spacing="18" style="-fx-padding: 22 28 22 22;">

            <!-- Section header -->
            <HBox alignment="BOTTOM_LEFT">
                <VBox spacing="5">
                    <Label styleClass="section-title" text="User Management"
                           style="-fx-font-size: 20px;" />
                    <Label styleClass="section-desc"
                           text="View, monitor, and moderate all registered accounts."
                           style="-fx-font-size: 11px;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="↻  REFRESH" onAction="#onRefresh"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            </HBox>

            <!-- User card grid -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;
                               -fx-border-color: transparent;">
                <FlowPane fx:id="userGrid" hgap="14" vgap="14"
                          style="-fx-padding: 4 0 20 0; -fx-background-color: transparent;" />
            </ScrollPane>

            <!-- Action bar -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="⛔  BAN SELECTED" onAction="#onBanUser"
                        styleClass="btn-danger"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
                <Button text="✅  UNBAN SELECTED" onAction="#onUnbanUser"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
                <Label fx:id="statusLabel" styleClass="bid-status"
                       style="-fx-font-size: 11px;" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
