<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane fx:controller="com.auction.client.controller.AuctionDetailController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="700"
            minWidth="960"  minHeight="680"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
              style="-fx-padding: 10 20 10 20;">
            <Label styleClass="logo-title" text="AuctionApp"
                   style="-fx-font-size: 15px;" />

            <HBox alignment="CENTER" spacing="20">
                <Label styleClass="nav-link" text="← BACK"
                       style="-fx-cursor: hand;"
                       onMouseClicked="#onBack" />
                <Label styleClass="nav-link-active" text="LOT DETAIL" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- ═══════════════════ CONTENT — split left / right ═══════════════════ -->
    <center>
        <HBox spacing="0" style="-fx-padding: 0;">

            <!-- ─── LEFT PANEL: item info + bidding ─── -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        prefWidth="420" minWidth="360"
                        style="-fx-background-color: transparent; -fx-background: transparent;
                               -fx-border-color: transparent #EAEAEA transparent transparent;
                               -fx-border-width: 1;">
                <VBox spacing="14" style="-fx-padding: 22 24 22 24;">

                    <!-- Item image -->
                    <StackPane prefHeight="210" maxWidth="370"
                               style="-fx-background-color: #F4F4F4;
                                      -fx-background-radius: 6;">
                        <ImageView fx:id="itemImageView"
                                   fitWidth="370" fitHeight="210"
                                   preserveRatio="true" smooth="true"
                                   visible="false" managed="false" />
                        <Label fx:id="itemImagePlaceholder"
                               text="No product image."
                               styleClass="table-placeholder"
                               wrapText="true" />
                    </StackPane>

                    <!-- Title + meta -->
                    <Text fx:id="labelTitle" styleClass="section-title"
                          wrappingWidth="370"
                          style="-fx-font-size: 17px;" />

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="CATEGORY" styleClass="card-meta" />
                        <Label fx:id="labelCategory" styleClass="card-subtitle"
                               style="-fx-font-size: 11px;" />
                    </HBox>

                    <Label fx:id="labelDescription" wrapText="true" maxWidth="370"
                           styleClass="section-desc"
                           style="-fx-font-size: 11px;" />

                    <Separator style="-fx-padding: 2 0;" />

                    <!-- Provenance rows -->
                    <HBox spacing="8">
                        <Label text="SELLER" styleClass="card-meta" />
                        <Label fx:id="labelSeller" styleClass="card-subtitle"
                               style="-fx-font-size: 11px;" />
                    </HBox>
                    <HBox spacing="8">
                        <Label text="STATUS" styleClass="card-meta" />
                        <Label fx:id="labelStatus" styleClass="time-badge" />
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="ENDS" styleClass="card-meta" />
                        <Label fx:id="labelEndTime" styleClass="card-subtitle"
                               style="-fx-font-size: 11px;" />
                        <Label fx:id="labelCountdown" styleClass="live-badge"
                               style="-fx-font-size: 10px;" />
                    </HBox>

                    <!-- Price hero row -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-padding: 10 14 10 14;
                                 -fx-background-color: #F8F8F8;
                                 -fx-background-radius: 6;">
                        <VBox spacing="2">
                            <Label text="CURRENT BID" styleClass="card-meta" />
                            <Label fx:id="labelCurrentPrice" styleClass="card-price"
                                   style="-fx-font-size: 22px;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox spacing="2" alignment="CENTER_RIGHT">
                            <Label text="LEADER" styleClass="card-meta" />
                            <Label fx:id="labelLeader" styleClass="card-subtitle"
                                   style="-fx-font-size: 11px;" />
                        </VBox>
                    </HBox>

                    <Separator style="-fx-padding: 2 0;" />

                    <!-- Manual bid -->
                    <Label text="PLACE A BID" styleClass="sidebar-title"
                           style="-fx-padding: 0;" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="bidAmountField" promptText="Amount ($)"
                                   styleClass="search-input" prefWidth="160" />
                        <Button fx:id="bidButton" text="BID NOW" onAction="#onPlaceBid"
                                styleClass="btn-primary"
                                style="-fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand;" />
                    </HBox>

                    <!-- Auto-bid -->
                    <Label text="AUTO-BID" styleClass="sidebar-title"
                           style="-fx-padding: 0;" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="autoBidMaxField" promptText="Max ($)"
                                   styleClass="search-input" prefWidth="110" />
                        <TextField fx:id="autoBidIncrField" promptText="Increment ($)"
                                   styleClass="search-input" prefWidth="120" />
                        <Button fx:id="autoBidButton" text="SET" onAction="#onSetAutoBid"
                                styleClass="btn-secondary"
                                style="-fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand;" />
                    </HBox>

                    <Label fx:id="bidStatusLabel" styleClass="bid-status"
                           wrapText="true" maxWidth="370"
                           style="-fx-font-size: 11px;" />

                </VBox>
            </ScrollPane>

            <!-- ─── RIGHT PANEL: chart + bid log ─── -->
            <VBox HBox.hgrow="ALWAYS" spacing="16"
                  style="-fx-padding: 22 24 22 24;">

                <!-- Price chart -->
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="4">
                        <Label styleClass="section-title" text="Price History"
                               style="-fx-font-size: 14px;" />
                        <Label styleClass="section-desc" text="Real-time bid progression."
                               style="-fx-font-size: 10px;" />
                    </VBox>
                </HBox>

                <LineChart fx:id="priceChart" VBox.vgrow="SOMETIMES" prefHeight="220"
                           legendVisible="false" styleClass="data-table"
                           style="-fx-background-color: #FAFAFA;
                                  -fx-border-color: #EAEAEA; -fx-border-radius: 6;
                                  -fx-background-radius: 6;">
                    <xAxis>
                        <NumberAxis fx:id="xAxis" label="Time" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="yAxis" label="Price ($)" />
                    </yAxis>
                </LineChart>

                <!-- Bid log -->
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="4">
                        <Label styleClass="section-title" text="Bid Log"
                               style="-fx-font-size: 14px;" />
                        <Label styleClass="section-desc" text="All bids for this lot, latest last."
                               style="-fx-font-size: 10px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="link-view-all" text="LIVE" />
                </HBox>

                <TableView fx:id="bidTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colBidder" text="BIDDER" prefWidth="140" />
                        <TableColumn fx:id="colAmount" text="AMOUNT" prefWidth="100" />
                        <TableColumn fx:id="colTime"   text="TIME"   prefWidth="85" />
                        <TableColumn fx:id="colAuto"   text="TYPE"   prefWidth="65" />
                    </columns>
                    <placeholder>
                        <Label text="No bids yet." styleClass="table-placeholder" />
                    </placeholder>
                </TableView>

            </VBox>
        </HBox>
    </center>

</BorderPane>