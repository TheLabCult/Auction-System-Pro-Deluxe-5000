<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.auction.client.controller.AuctionListController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="680"
            minWidth="900"  minHeight="620"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
              style="-fx-padding: 10 20 10 20;">
            <Label styleClass="logo-title" text="AuctionApp"
                   style="-fx-font-size: 15px;" />

            <HBox alignment="CENTER" spacing="20">
                <Label styleClass="nav-link-active" text="AUCTIONS" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Search box — matches curated.fxml search-box pattern -->
            <HBox alignment="CENTER_LEFT" styleClass="search-box">
                <Label style="-fx-text-fill: #888;" text="🔍" />
                <TextField fx:id="searchField"
                           promptText="Search by item name or status…"
                           prefWidth="220"
                           styleClass="search-input" />
            </HBox>

            <Label fx:id="userLabel"
                   style="-fx-font-size: 11px; -fx-text-fill: #888;
                          -fx-font-family: 'Georgia', serif;
                          -fx-font-style: italic;" />

            <HBox alignment="CENTER" spacing="12">
                <Button text="↻  REFRESH" onAction="#onRefresh"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
                <Button fx:id="logoutButton" text="LOG OUT" onAction="#onLogout"
                        styleClass="btn-danger"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <left>
        <AnchorPane prefWidth="160" minWidth="160"
                    style="-fx-border-color: transparent #EAEAEA transparent transparent;
                           -fx-border-width: 1;">

            <!-- Top nav items — rebuilt dynamically by applySidebar() -->
            <VBox fx:id="sidebarBox" spacing="3" styleClass="sidebar"
                  style="-fx-border-color: transparent; -fx-padding: 20 0 0 0;
                         -fx-background-color: transparent;"
                  AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                <Label fx:id="sidebarTitle"    styleClass="sidebar-title"    text="CATEGORIES"
                       style="-fx-padding: 0 0 0 18;" />
                <Label fx:id="sidebarSubtitle" styleClass="sidebar-subtitle" text="FILTER LOTS"
                       style="-fx-padding: 0 0 10 18;" />
                <!-- category rows inserted here at runtime by applySidebar() -->
            </VBox>

            <!-- Profile — permanently anchored to bottom, never rebuilt -->
            <VBox fx:id="sidebarProfileBox" spacing="0"
                  AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18; -fx-cursor: hand;"
                      onMouseClicked="#onViewProfile">
                    <Label styleClass="category-text" text="👤" />
                    <Label styleClass="category-text" text="MY PROFILE" />
                </HBox>
            </VBox>

        </AnchorPane>
    </left>

    <!-- ═══════════════════ CONTENT ═══════════════════ -->
    <center>
        <VBox spacing="18" style="-fx-padding: 22 28 22 22;">

            <!-- Section header -->
            <HBox alignment="BOTTOM_LEFT">
                <VBox spacing="5">
                    <Label styleClass="section-title" text="Live Auctions"
                           style="-fx-font-size: 20px;" />
                    <Label styleClass="section-desc"
                           text="Double-click any lot to view full details and place a bid."
                           style="-fx-font-size: 11px;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="VIEW SELECTED" onAction="#onViewDetail"
                        styleClass="link-view-all"
                        style="-fx-cursor: hand;" />
            </HBox>

            <!-- Auction table -->
            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colId"     text="#"       prefWidth="55" />
                    <TableColumn fx:id="colItem"   text="ITEM"    prefWidth="270" />
                    <TableColumn fx:id="colPrice"  text="PRICE"   prefWidth="120" />
                    <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="120" />
                    <TableColumn fx:id="colStatus" text="STATUS"  prefWidth="120" />
                    <TableColumn fx:id="colEnds"   text="ENDS"    prefWidth="150" />
                    <TableColumn fx:id="colWins"   text="WINNER"  prefWidth="120" />
                </columns>
                <placeholder>
                    <Label text="No auctions found." styleClass="table-placeholder" />
                </placeholder>
            </TableView>

        </VBox>
    </center>

</BorderPane>