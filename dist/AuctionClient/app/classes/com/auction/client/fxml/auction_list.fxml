<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.auction.client.controller.AuctionListController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="680"
            minWidth="900"  minHeight="620"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
              style="-fx-padding: 10 20 10 20;">
            <Label styleClass="logo-title" text="AuctionApp"
                   style="-fx-font-size: 15px;" />

            <HBox alignment="CENTER" spacing="20">
                <Label fx:id="navAuctions" styleClass="nav-link-active" text="AUCTIONS"
                       onMouseClicked="#onNavAuctions" style="-fx-cursor: hand;" />
                <Label fx:id="navSellers"  styleClass="nav-link"        text="SELLERS"
                       onMouseClicked="#onNavSellers"  style="-fx-cursor: hand;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Search box -->
            <HBox alignment="CENTER_LEFT" styleClass="search-box">
                <Label style="-fx-text-fill: #888;" text="🔍" />
                <TextField fx:id="searchField"
                           promptText="Search by item name or status…"
                           prefWidth="220"
                           styleClass="search-input" />
            </HBox>

            <Label fx:id="userLabel"
                   style="-fx-font-size: 11px; -fx-text-fill: #888;
                          -fx-font-family: 'Georgia', serif;
                          -fx-font-style: italic;" />

            <HBox alignment="CENTER" spacing="12">
                <Button text="↻  REFRESH" onAction="#onRefresh"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
                <Button fx:id="logoutButton" text="LOG OUT" onAction="#onLogout"
                        styleClass="btn-danger"
                        style="-fx-font-size: 10px; -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <left>
        <AnchorPane prefWidth="160" minWidth="160"
                    style="-fx-border-color: transparent #EAEAEA transparent transparent;
                           -fx-border-width: 1;">

            <!-- Top nav items — rebuilt dynamically by applySidebar() -->
            <VBox fx:id="sidebarBox" spacing="3" styleClass="sidebar"
                  style="-fx-border-color: transparent; -fx-padding: 20 0 0 0;
                         -fx-background-color: transparent;"
                  AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                <Label fx:id="sidebarTitle"    styleClass="sidebar-title"    text="CATEGORIES"
                       style="-fx-padding: 0 0 0 18;" />
                <Label fx:id="sidebarSubtitle" styleClass="sidebar-subtitle" text="FILTER LOTS"
                       style="-fx-padding: 0 0 10 18;" />
                <!-- category rows inserted here at runtime by applySidebar() -->
            </VBox>

            <!-- Profile — permanently anchored to bottom, never rebuilt -->
            <VBox fx:id="sidebarProfileBox" spacing="0"
                  AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18; -fx-cursor: hand;"
                      onMouseClicked="#onViewProfile">
                    <Label styleClass="category-text" text="👤" />
                    <Label styleClass="category-text" text="MY PROFILE" />
                </HBox>
            </VBox>

        </AnchorPane>
    </left>

    <!-- ═══════════════════ CONTENT ═══════════════════ -->
    <center>
        <StackPane>

            <!-- ── AUCTIONS PANEL ── -->
            <VBox fx:id="auctionsPanel" spacing="18" style="-fx-padding: 22 28 22 22;">
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="5">
                        <!-- Back breadcrumb — hidden unless filtering by seller -->
                        <HBox fx:id="sellerBreadcrumb" alignment="CENTER_LEFT" spacing="6"
                              visible="false" managed="false"
                              style="-fx-cursor: hand;" onMouseClicked="#onClearSellerFilter">
                            <Label text="←" style="-fx-text-fill: #888; -fx-font-size: 11px;" />
                            <Label text="All Sellers" style="-fx-text-fill: #888;
                                   -fx-font-size: 11px; -fx-underline: true;" />
                        </HBox>
                        <Label fx:id="auctionsPanelTitle" styleClass="section-title"
                               text="Live Auctions" style="-fx-font-size: 20px;" />
                        <Label fx:id="auctionsPanelDesc" styleClass="section-desc"
                               text="Click any lot to view full details and place a bid."
                               style="-fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <FlowPane fx:id="auctionGrid"
                              hgap="14" vgap="14"
                              style="-fx-padding: 4 0 20 0; -fx-background-color: transparent;" />
                </ScrollPane>
            </VBox>

            <!-- ── SELLERS PANEL ── -->
            <VBox fx:id="sellersPanel" spacing="18" style="-fx-padding: 22 28 22 22;"
                  visible="false" managed="false">
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="5">
                        <Label styleClass="section-title" text="Sellers"
                               style="-fx-font-size: 20px;" />
                        <Label styleClass="section-desc"
                               text="Browse active sellers on the platform."
                               style="-fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <FlowPane fx:id="sellersGrid"
                              hgap="14" vgap="14"
                              style="-fx-padding: 4 0 20 0; -fx-background-color: transparent;" />
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
