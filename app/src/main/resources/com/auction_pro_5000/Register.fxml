<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.auction_pro_5000.controller.RegisterController">
   <children>
      <Label text="ĐĂNG KÝ HỆ THỐNG ĐẤU GIÁ">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <VBox spacing="5.0">
         <children>
            <Label text="Họ và tên:" />
            <TextField fx:id="txtFullName" promptText="Nhập họ tên đầy đủ" />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Tên đăng nhập:" />
            <TextField fx:id="txtUser" promptText="Tên đăng nhập duy nhất" />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Mật khẩu:" />
            <PasswordField fx:id="txtPass" promptText="Mật khẩu bảo mật" />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Email:" />
            <TextField fx:id="txtemail" promptText="Email chưa đăng ký" />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="CMND/CCCD:" />
            <TextField fx:id="txtpersonalID" promptText="Nhập số CMND/CCCD" />
         </children>
      </VBox>

      <Button fx:id="registerBtn" mnemonicParsing="false" 
              onAction="#handleRegister" text="Đăng ký ngay" 
              style="-fx-background-color: #2ecc71; -fx-text-fill: white;">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>

      <Button text = "Đã có tài khoản? Đăng nhập ngay" 
              onAction="#handleShowLogin" 
              style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true;">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
   </padding>
</VBox>