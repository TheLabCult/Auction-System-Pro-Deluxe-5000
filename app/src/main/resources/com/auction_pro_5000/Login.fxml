<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.com.auction_pro_5000.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Đăng nhập hệ thống" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <TextField fx:id="txtUser" promptText="Tên đăng nhập" maxWidth="220" />
    <PasswordField fx:id="txtPass" promptText="Mật khẩu" maxWidth="220" />
    <Button fx:id="loginBtn" text="Đăng nhập" onAction="#handleLogin" minWidth="100" />
</VBox>