<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane prefWidth="1000.0"
            prefHeight="780.0"
            style="-fx-background-color: #FBFBFB; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controllers.RegisterController">

    <!-- Top Nav Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" minWidth="-Infinity"
              style="-fx-padding: 16 50 16 50; -fx-border-color: transparent transparent #E8E8E8 transparent; -fx-border-width: 1;">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111;" text="AuctionApp" />
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox alignment="CENTER" spacing="50" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30" left="60" right="60" top="30" />
            </padding>

            <!-- Left branding text — reduced font size so it fits alongside the tall form -->
            <VBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <TextFlow lineSpacing="2">
                    <Text style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-fill: #111;" text="Join the&#10;" />
                    <Text style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-fill: #111;" text="Best Bidding&#10;" />
                    <Text style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-fill: #5B6C7E;" text="Community." />
                </TextFlow>
                <Label style="-fx-font-size: 14px; -fx-text-fill: #888; -fx-padding: 6 0 0 0;"
                       text="Create your free account and start bidding today." />
            </VBox>

            <!-- Right side: ScrollPane wrapping the register card -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        prefWidth="440"
                        maxHeight="680"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">

                <VBox alignment="CENTER" spacing="0" style="-fx-padding: 6 0 6 0;">
                    <VBox prefWidth="400" spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 16, 0, 0, 6);">

                        <!-- Title -->
                        <VBox spacing="4">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111;"
                                   text="Create an account" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #888;"
                                   text="It's free and only takes a minute." />
                        </VBox>

                        <!-- Full Name -->
                        <VBox spacing="5" style="-fx-padding: 8 0 0 0;">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"
                                   text="Full Name" />
                            <TextField fx:id="fullNameTextField"
                                       promptText="John Doe"
                                       style="-fx-background-color: #EFEFEF; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"
                                   text="Email" />
                            <TextField fx:id="emailTextField"
                                       promptText="you@example.com"
                                       style="-fx-background-color: #EFEFEF; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Username -->
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"
                                   text="Username" />
                            <TextField fx:id="usernameTextField"
                                       promptText="Choose a username"
                                       style="-fx-background-color: #EFEFEF; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"
                                   text="Password" />
                            <PasswordField fx:id="passwordField"
                                           promptText="••••••••"
                                           style="-fx-background-color: #EFEFEF; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"
                                   text="Confirm Password" />
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="••••••••"
                                           style="-fx-background-color: #EFEFEF; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Register Button -->
                        <Button fx:id="registerButton"
                                maxWidth="Infinity"
                                onAction="#registerButtonOnAction"
                                prefHeight="44.0"
                                style="-fx-background-color: #111; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"
                                text="Create Account"
                                VBox.vgrow="ALWAYS" />

                        <!-- Message Label -->
                        <Label fx:id="registerMessageLabel"
                               maxWidth="Infinity"
                               textFill="#eb0505"
                               wrapText="true"
                               style="-fx-font-size: 12px;" />

                        <!-- Divider -->
                        <HBox alignment="CENTER" spacing="12" style="-fx-padding: 2 0;">
                            <Separator HBox.hgrow="ALWAYS" />
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #888;" text="or" />
                            <Separator HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Social Buttons -->
                        <HBox spacing="12">
                            <Button maxWidth="Infinity"
                                    style="-fx-background-color: #F0F0F0; -fx-text-fill: #111; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"
                                    text="G  GOOGLE"
                                    HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity"
                                    style="-fx-background-color: #F0F0F0; -fx-text-fill: #111; -fx-padding: 11; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"
                                    text="  APPLE"
                                    HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Back to Login -->
                        <HBox alignment="CENTER" style="-fx-padding: 4 0 0 0;">
                            <TextFlow textAlignment="CENTER">
                                <Text style="-fx-font-size: 12px; -fx-fill: #666;" text="Already have an account? " />
                                <Text fx:id="backToLoginText"
                                      style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-fill: #111; -fx-cursor: hand;"
                                      text="Sign in"
                                      onMouseClicked="#backToLoginOnAction" />
                            </TextFlow>
                        </HBox>

                    </VBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 18 50 18 50; -fx-background-color: #EFEFEF;">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #333;"
                   text="© 2026 PRODUCT OF HQLP" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="30">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: bold; -fx-cursor: hand;"
                       text="PRIVACY" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: bold; -fx-cursor: hand;"
                       text="TERMS" />
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
