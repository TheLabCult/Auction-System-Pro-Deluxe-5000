<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.auction.client.controllers.ArtistsController"
            styleClass="root-pane"
            prefWidth="1000"
            prefHeight="680"
            minWidth="800"
            minHeight="500"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
              style="-fx-padding: 10 20 10 20;">
            <Label styleClass="logo-title" text="AuctionApp"
                   style="-fx-font-size: 15px;" />

            <HBox alignment="CENTER" spacing="20">
                <Label styleClass="nav-link"        text="AUCTIONS"
                       onMouseClicked="#onNavAuctions" />
                <Label styleClass="nav-link-active" text="ARTISTS"
                       onMouseClicked="#onNavArtists" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" styleClass="search-box">
                <Label style="-fx-text-fill: #888;" text="🔍" />
                <TextField fx:id="searchTextField" onAction="#onSearchAction"
                           prefWidth="160" promptText="Search artists..."
                           styleClass="search-input" />
            </HBox>

            <HBox alignment="CENTER" spacing="12">
                <Label style="-fx-font-size: 14px; -fx-cursor: hand;" text="🔔"
                       onMouseClicked="#onNotificationsClicked" />
                <Label style="-fx-font-size: 14px; -fx-cursor: hand;" text="👤"
                       onMouseClicked="#onProfileClicked" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent #EAEAEA transparent transparent;
                           -fx-border-width: 1;">
            <VBox prefWidth="160" spacing="3" styleClass="sidebar"
                  style="-fx-border-color: transparent; -fx-padding: 20 0 0 0;">
                <Label styleClass="sidebar-title"    text="SPECIALTIES"
                       style="-fx-padding: 0 0 0 18;" />
                <Label styleClass="sidebar-subtitle" text="BROWSE BY DISCIPLINE"
                       style="-fx-padding: 0 0 10 18;" />

                <HBox fx:id="catPainting" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item-active"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="🖼" />
                    <Label styleClass="category-text" text="PAINTING" />
                </HBox>
                <HBox fx:id="catSculpture" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="🗿" />
                    <Label styleClass="category-text" text="SCULPTURE" />
                </HBox>
                <HBox fx:id="catPhotography" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="📷" />
                    <Label styleClass="category-text" text="PHOTOGRAPHY" />
                </HBox>
                <HBox fx:id="catPrintmaking" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="🖨" />
                    <Label styleClass="category-text" text="PRINTMAKING" />
                </HBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- ═══════════════════ CONTENT ═══════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="18" style="-fx-padding: 22 28 22 22;">

                <!-- Section header -->
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="5">
                        <Label styleClass="section-title" text="Featured Artists"
                               style="-fx-font-size: 20px;" />
                        <Label styleClass="section-desc"
                               text="Discover the visionaries behind the world's most sought-after works."
                               style="-fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="link-view-all" text="VIEW ALL ARTISTS"
                           onMouseClicked="#onViewAllArtists" />
                </HBox>

                <!-- Artist card grid — 3 columns at 1000px wide -->
                <FlowPane fx:id="artistGrid" hgap="14" vgap="14" prefWrapLength="800">

                    <!-- Card 1 -->
                    <VBox prefWidth="210" styleClass="auction-card">
                        <StackPane prefHeight="160" styleClass="img-large" />
                        <VBox spacing="5" styleClass="card-content"
                              style="-fx-padding: 10;">
                            <Label styleClass="card-meta"     text="CONTEMPORARY • PAINTING" />
                            <Label styleClass="card-title"    text="Elena Marchetti"
                                   style="-fx-font-size: 13px;" />
                            <Label styleClass="card-subtitle" text="Italian, b. 1974"
                                   style="-fx-font-size: 11px;" />
                            <Label styleClass="card-meta"     text="42 LOTS AVAILABLE" />
                        </VBox>
                    </VBox>

                    <!-- Card 2 -->
                    <VBox prefWidth="210" styleClass="auction-card">
                        <StackPane prefHeight="160" styleClass="img-small-1" />
                        <VBox spacing="5" styleClass="card-content"
                              style="-fx-padding: 10;">
                            <Label styleClass="card-meta"     text="POST-WAR • SCULPTURE" />
                            <Label styleClass="card-title"    text="Haruto Nakamura"
                                   style="-fx-font-size: 13px;" />
                            <Label styleClass="card-subtitle" text="Japanese, b. 1961"
                                   style="-fx-font-size: 11px;" />
                            <Label styleClass="card-meta"     text="17 LOTS AVAILABLE" />
                        </VBox>
                    </VBox>

                    <!-- Card 3 -->
                    <VBox prefWidth="210" styleClass="auction-card">
                        <StackPane prefHeight="160" styleClass="img-small-2" />
                        <VBox spacing="5" styleClass="card-content"
                              style="-fx-padding: 10;">
                            <Label styleClass="card-meta"     text="MODERN • PHOTOGRAPHY" />
                            <Label styleClass="card-title"    text="Isabelle Fontaine"
                                   style="-fx-font-size: 13px;" />
                            <Label styleClass="card-subtitle" text="French, b. 1980"
                                   style="-fx-font-size: 11px;" />
                            <Label styleClass="card-meta"     text="9 LOTS AVAILABLE" />
                        </VBox>
                    </VBox>

                    <!-- Card 4 -->
                    <VBox prefWidth="210" styleClass="auction-card">
                        <StackPane prefHeight="160" styleClass="img-large" />
                        <VBox spacing="5" styleClass="card-content"
                              style="-fx-padding: 10;">
                            <Label styleClass="card-meta"     text="ABSTRACT • PRINTMAKING" />
                            <Label styleClass="card-title"    text="Samuel Okafor"
                                   style="-fx-font-size: 13px;" />
                            <Label styleClass="card-subtitle" text="Nigerian-British, b. 1969"
                                   style="-fx-font-size: 11px;" />
                            <Label styleClass="card-meta"     text="31 LOTS AVAILABLE" />
                        </VBox>
                    </VBox>

                    <!-- Card 5 -->
                    <VBox prefWidth="210" styleClass="auction-card">
                        <StackPane prefHeight="160" styleClass="img-small-1" />
                        <VBox spacing="5" styleClass="card-content"
                              style="-fx-padding: 10;">
                            <Label styleClass="card-meta"     text="CONTEMPORARY • PAINTING" />
                            <Label styleClass="card-title"    text="Mei Liang Zhou"
                                   style="-fx-font-size: 13px;" />
                            <Label styleClass="card-subtitle" text="Chinese-American, b. 1988"
                                   style="-fx-font-size: 11px;" />
                            <Label styleClass="card-meta"     text="5 LOTS AVAILABLE" />
                        </VBox>
                    </VBox>

                    <!-- Card 6 -->
                    <VBox prefWidth="210" styleClass="auction-card">
                        <StackPane prefHeight="160" styleClass="img-small-2" />
                        <VBox spacing="5" styleClass="card-content"
                              style="-fx-padding: 10;">
                            <Label styleClass="card-meta"     text="SURREALIST • SCULPTURE" />
                            <Label styleClass="card-title"    text="André Voss"
                                   style="-fx-font-size: 13px;" />
                            <Label styleClass="card-subtitle" text="German, b. 1955"
                                   style="-fx-font-size: 11px;" />
                            <Label styleClass="card-meta"     text="23 LOTS AVAILABLE" />
                        </VBox>
                    </VBox>

                </FlowPane>

                <!-- Footer -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-padding: 20 0 30 0; -fx-background-color: #F8F8F8;">
                    <Label styleClass="footer-logo" text="CURATED"
                           style="-fx-font-size: 13px;" />
                    <HBox alignment="CENTER" spacing="20">
                        <Label styleClass="footer-link" text="TERMS OF SALE" />
                        <Label styleClass="footer-link" text="PRIVACY POLICY" />
                        <Label styleClass="footer-link" text="CONSIGNMENT SERVICES" />
                        <Label styleClass="footer-link" text="GLOBAL LOCATIONS" />
                    </HBox>
                    <Label styleClass="footer-copyright"
                           text="© 2024 CURATED EDITORIAL AUCTION HOUSE. ALL RIGHTS RESERVED." />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
