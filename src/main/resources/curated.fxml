<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.auction.client.controllers.CuratedController"
            styleClass="root-pane"
            prefWidth="1000"
            prefHeight="680"
            minWidth="800"
            minHeight="500"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="header"
              style="-fx-padding: 10 20 10 20;">
            <Label styleClass="logo-title" text="AuctionApp"
                   style="-fx-font-size: 15px;" />

            <HBox alignment="CENTER" spacing="20">
                <Label styleClass="nav-link-active" text="AUCTIONS"
                       onMouseClicked="#onNavAuctions" />
                <Label styleClass="nav-link" text="ARTISTS"
                       onMouseClicked="#onNavArtists" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" styleClass="search-box">
                <Label style="-fx-text-fill: #888;" text="🔍" />
                <TextField fx:id="searchTextField" onAction="#onSearchAction"
                           prefWidth="160" promptText="Search lots, artists..."
                           styleClass="search-input" />
            </HBox>

            <HBox alignment="CENTER" spacing="12">
                <Label style="-fx-font-size: 14px; -fx-cursor: hand;" text="🔔"
                       onMouseClicked="#onNotificationsClicked" />
                <Label style="-fx-font-size: 14px; -fx-cursor: hand;" text="👤"
                       onMouseClicked="#onProfileClicked" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent #EAEAEA transparent transparent;
                           -fx-border-width: 1;">
            <VBox prefWidth="160" spacing="3" styleClass="sidebar"
                  style="-fx-border-color: transparent; -fx-padding: 20 0 0 0;">
                <Label styleClass="sidebar-title"    text="CATEGORIES"
                       style="-fx-padding: 0 0 0 18;" />
                <Label styleClass="sidebar-subtitle" text="VETTED COLLECTIONS"
                       style="-fx-padding: 0 0 10 18;" />

                <HBox fx:id="catArt" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item-active"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="🎨" />
                    <Label styleClass="category-text" text="ART" />
                </HBox>
                <HBox fx:id="catVehicle" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="🚗" />
                    <Label styleClass="category-text" text="VEHICLE" />
                </HBox>
                <HBox fx:id="catElectronic" alignment="CENTER_LEFT" spacing="8"
                      styleClass="category-item"
                      style="-fx-padding: 9 18 9 18;">
                    <Label styleClass="category-text" text="📺" />
                    <Label styleClass="category-text" text="ELECTRONIC" />
                </HBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- ═══════════════════ CONTENT ═══════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="18" style="-fx-padding: 22 28 22 22;">

                <!-- Section header -->
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="5">
                        <Label styleClass="section-title" text="Auction Edit"
                               style="-fx-font-size: 20px;" />
                        <Label styleClass="section-desc"
                               text="Meticulously assembled modern masterpieces entering the market this season."
                               style="-fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="link-view-all" text="VIEW ALL LOTS"
                           onMouseClicked="#onViewAllLots" />
                </HBox>

                <!-- Cards row -->
                <HBox spacing="14">

                    <!-- Featured large card -->
                    <VBox prefWidth="380" styleClass="auction-card" HBox.hgrow="ALWAYS">
                        <StackPane prefHeight="220" styleClass="img-large">
                            <Label styleClass="live-badge" text="● LIVE"
                                   StackPane.alignment="TOP_RIGHT">
                                <StackPane.margin><Insets right="10" top="10" /></StackPane.margin>
                            </Label>
                        </StackPane>
                        <VBox spacing="6" styleClass="card-content"
                              style="-fx-padding: 12;">
                            <HBox>
                                <Label styleClass="card-meta" text="LOT 42 • POST-WAR &amp; CONTEMPORARY" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="card-meta" text="CURRENT BID" />
                            </HBox>
                            <HBox>
                                <Label styleClass="card-title" text="Untitled (Black &amp; Ochre)"
                                       style="-fx-font-size: 14px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="card-price" text="\$1.2M"
                                       style="-fx-font-size: 15px;" />
                            </HBox>
                            <HBox>
                                <Label styleClass="card-subtitle" text="Artist Unknown, Circa 1958"
                                       style="-fx-font-size: 11px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="time-badge" text="⏱ 02:14:45 left" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Two small cards -->
                    <VBox prefWidth="240" spacing="14">

                        <VBox styleClass="auction-card">
                            <StackPane prefHeight="110" styleClass="img-small-1" />
                            <VBox spacing="5" styleClass="card-content"
                                  style="-fx-padding: 10;">
                                <Label styleClass="card-meta" text="LOT 18 • IMPORTANT TIMEPIECES" />
                                <Label styleClass="card-title" text="Chronograph Ref. 6239"
                                       style="-fx-font-size: 13px;" />
                                <Label styleClass="card-subtitle" text="Stainless Steel, 1968"
                                       style="-fx-font-size: 11px;" />
                                <Separator style="-fx-padding: 2 0;" />
                                <HBox alignment="BOTTOM_LEFT">
                                    <VBox>
                                        <Label styleClass="card-meta" text="CURRENT BID" />
                                        <Label styleClass="card-price" text="\$85,000"
                                               style="-fx-font-size: 14px;" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="time-badge" text="⏱ 14h 20m" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox styleClass="auction-card">
                            <StackPane prefHeight="110" styleClass="img-small-2" />
                            <VBox spacing="5" styleClass="card-content"
                                  style="-fx-padding: 10;">
                                <Label styleClass="card-meta" text="LOT 104 • MAGNIFICENT JEWELS" />
                                <Label styleClass="card-title" text="Sapphire &amp; Diamond Rivière"
                                       style="-fx-font-size: 13px;" />
                                <Label styleClass="card-subtitle" text="Unmounted, 15.2 Carats"
                                       style="-fx-font-size: 11px;" />
                                <Separator style="-fx-padding: 2 0;" />
                                <HBox alignment="BOTTOM_LEFT">
                                    <VBox>
                                        <Label styleClass="card-meta" text="CURRENT BID" />
                                        <Label styleClass="card-price" text="\$420,000"
                                               style="-fx-font-size: 14px;" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="time-badge" text="⏱ 1d 08h" />
                                </HBox>
                            </VBox>
                        </VBox>

                    </VBox>
                </HBox>

                <!-- Footer -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-padding: 20 0 30 0; -fx-background-color: #F8F8F8;">
                    <Label styleClass="footer-logo" text="CURATED"
                           style="-fx-font-size: 13px;" />
                    <HBox alignment="CENTER" spacing="20">
                        <Label styleClass="footer-link" text="TERMS OF SALE" />
                        <Label styleClass="footer-link" text="PRIVACY POLICY" />
                        <Label styleClass="footer-link" text="CONSIGNMENT SERVICES" />
                        <Label styleClass="footer-link" text="GLOBAL LOCATIONS" />
                    </HBox>
                    <Label styleClass="footer-copyright"
                           text="© 2024 CURATED EDITORIAL AUCTION HOUSE. ALL RIGHTS RESERVED." />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
